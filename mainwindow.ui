        <property name="styleSheet">
         <string notr="true">QTextEdit#caja_nombre {
    background-color: #fbd9a0;
    color: #000000;
    border: 2px solid #7a4a00;
    border-radius: 10px;
    
    /* Forzamos negrita intensa y un pequeño truco de grosor extra si el sistema lo soporta */
    font-weight: 800;
    font-size: 13px;
    
    /* Padding milimétrico para que la 'g' no toque los bordes con este grosor */
    padding: 5px 10px 4px 10px;
    
    /* Mantenemos estrictamente los 40px */
    min-width: 220px;
    max-width: 220px;
    min-height: 40px;
    max-height: 40px;
}

QTextEdit#caja_nombre:focus {
    border: 2px solid #c62828;
    background-color: #ffe5b8;
    outline: 0;
}</string>
        </property>
        <property name="html">
         <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
