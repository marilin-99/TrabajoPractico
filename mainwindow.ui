        <property name="styleSheet">
         <string notr="true">QPushButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #b45309,
        stop:1 #78350f
    );

    color: #fff7ed;

    /* Borde dorado/ámbar cálido para resaltar sobre el marrón */
    border: 3px solid #f59e0b;
    border-radius: 18px;

    font-size: 20px;
    font-weight: bold;

    padding: 12px;
    min-width: 220px;
    max-width: 220px;
    min-height: 50px;
    max-height: 50px;
}

/* Hover (Al pasar el mouse) */
QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #d97706,
        stop:1 #92400e
    );

    /* Borde más brillante al pasar el cursor */
    border: 3px solid #fbbf24;
    color: white;
}

/* Click (Al presionar) */
QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #451a03,
        stop:1 #1c0a02
    );

    border: 3px solid #d97706;
    padding-top: 15px;
}

/* Deshabilitado */
QPushButton:disabled {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #4b4038,
        stop:1 #211b18
    );

    color: #8b8178;
    border: 3px solid #665b52;
}</string>
