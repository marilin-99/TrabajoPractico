        <property name="styleSheet">
         <string notr="true">QComboBox {
    background-color: #fbd9a0;
    color: black;
    border: 2px solid #7a4a00;
    border-radius: 10px;
    padding: 4px 28px 4px 10px;
    font-size: 13px;
    min-width: 220px;
    max-width: 220px;
    min-height: 40px;
    max-height: 40px;
}

QComboBox:focus {
    border: 2px solid #c62828;
    background-color: #ffe5b8;
    outline: 0;
}

/* Botoncito más angosto y con un tono crema cálido (no blanco) */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 24px;
    background-color: #fce8c7;
    /* Bisel 3D suave acorde al estilo rústico */
    border-left: 1px solid #7a4a00;
    border-top: 1px solid #ffeecc;
    border-right: 1px solid #b88642;
    border-bottom: 1px solid #b88642;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::drop-down:pressed {
    background-color: #e6c594;
    border-top: 1px solid #b88642;
    border-bottom: 1px solid #ffeecc;
}

/* La flechita marrón centrada y proporcionada */
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7a4a00;
    width: 0px;
    height: 0px;
    margin-right: 2px;
}

QComboBox QAbstractItemView {
    background-color: #fbd9a0;
    color: black;
    border: 2px solid #7a4a00;
    selection-background-color: #e0a64d;
    selection-color: black;
    outline: 0;
}</string>
