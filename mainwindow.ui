        <property name="styleSheet">
         <string notr="true">QPushButton {



background: qlineargradient(

x1:0, y1:0,

x2:0, y2:1,

stop:0 #b91c1c,

stop:1 #3f0000

);



color: #fff7ed;



border: 3px solid #f59e0b;

