      <item row="25" column="4">
       <widget class="QPushButton" name="cargar_partida">
        <property name="styleSheet">
         <string notr="true">


QPushButton#cargar_partida {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #10b981,
        stop:1 #065f46
    );

    color: white;

    /* Borde verde principal (más claro para destacar) */
    border: 3px solid #34d399;
    border-radius: 18px;

    font-size: 20px;
    font-weight: bold;

    padding: 12px;
    min-height: 50px;
    max-height: 50px;
}

QPushButton#cargar_partida:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #34d399,
        stop:1 #047857
    );

    /* Borde verde más brillante al pasar el mouse */
    border: 3px solid #6ee7b7;
}

QPushButton#cargar_partida:pressed {
    background: #064e3b;
    
    /* Borde verde suave al presionar */
    border: 3px solid #059669;
}</string>
        </property>
        <property name="text">
         <string>Cargar</string>
        </property>
