diff --git a/formato_partida.cpp b/formato_partida.cpp
new file mode 100644
index 0000000..2bef35f
--- /dev/null
+++ b/formato_partida.cpp
@@ -0,0 +1,82 @@
+#include "formato_partida.h"
+
+namespace {
+
+void escribir_u32(std::string &salida, std::uint32_t valor)
+{
+    for (int i = 0; i < 4; i++)
+        salida.push_back(static_cast<char>((valor >> (8 * i)) & 0xFF));
+}
+
+void escribir_u64(std::string &salida, std::uint64_t valor)
+{
+    for (int i = 0; i < 8; i++)
+        salida.push_back(static_cast<char>((valor >> (8 * i)) & 0xFF));
+}
+
+void escribir_cartas(std::string &salida, const std::vector<carta> &cartas)
+{
+    escribir_u32(salida, static_cast<std::uint32_t>(cartas.size()));
+    for (const carta &c : cartas) {
+        salida.push_back(static_cast<char>(static_cast<std::uint8_t>(c.getTipo())));
+        // la vida va como entero de 32 bits con signo
+        escribir_u32(salida, static_cast<std::uint32_t>(c.get_vida()));
+    }
+}
+
+} // namespace
+
+std::string serializar_partida(const datos_partida &datos)
+{
+    std::string salida;
+
+    salida.append("TPPG", 4);                                        // marca
+    escribir_u32(salida, 1);                                         // versión
+    escribir_u64(salida, static_cast<std::uint64_t>(datos.fecha));   // fecha
+    escribir_u32(salida, static_cast<std::uint32_t>(datos.dificultad_ia));
+
+    escribir_u32(salida, static_cast<std::uint32_t>(datos.nombre.size()));
+    salida.append(datos.nombre);
+
+    escribir_cartas(salida, datos.cartas_player);
+    escribir_cartas(salida, datos.cartas_ia);
+
+    return salida;
+}
+
+std::string nombre_de_archivo(const std::string &nombre)
+{
+    // Los espacios, los caracteres de control y los que no se pueden usar en
+    // un nombre de archivo (\ / : * ? " < > |) pasan a ser "_". Los bytes de
+    // letras con tilde u otros alfabetos (>= 0x80) se dejan como están.
+    const std::string prohibidos = "\\/:*?\"<>|";
+    std::string limpio;
+    for (unsigned char c : nombre) {
+        bool invalido = c < 0x20 || c == 0x7F || c == ' ' ||
+                        prohibidos.find(static_cast<char>(c)) != std::string::npos;
+        if (!invalido)
+            limpio.push_back(static_cast<char>(c));
+        else if (limpio.empty() || limpio.back() != '_')
+            limpio.push_back('_');
+    }
+
+    // Máximo 40 bytes, sin cortar una letra UTF-8 por la mitad
+    if (limpio.size() > 40) {
+        size_t corte = 40;
+        while (corte > 0 && (static_cast<unsigned char>(limpio[corte]) & 0xC0) == 0x80)
+            corte--;
+        limpio.resize(corte);
+    }
+
+    // Sin "_" ni "." al principio o al final
+    size_t inicio = limpio.find_first_not_of("_.");
+    if (inicio == std::string::npos)
+        limpio.clear();
+    else
+        limpio = limpio.substr(inicio, limpio.find_last_not_of("_.") - inicio + 1);
+
+    if (limpio.empty())
+        limpio = "sin_nombre";
+
+    return "partida_" + limpio + ".bin";
+}
diff --git a/formato_partida.h b/formato_partida.h
new file mode 100644
index 0000000..67edfe7
--- /dev/null
+++ b/formato_partida.h
@@ -0,0 +1,43 @@
+#ifndef FORMATO_PARTIDA_H
+#define FORMATO_PARTIDA_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+#include "carta.h"
+
+// Todo lo necesario para poder reanudar una partida más adelante.
+struct datos_partida
+{
+    std::string nombre;                // nombre del jugador (texto UTF-8)
+    std::int64_t fecha = 0;            // segundos desde 1970 (0 = que se complete al guardar)
+    int dificultad_ia = 0;             // 1 aleatoria, 2 estratégica, 3 super
+    std::vector<carta> cartas_player;  // cartas del jugador con su vida actual
+    std::vector<carta> cartas_ia;      // cartas de la IA con su vida actual
+};
+
+// Convierte la partida en los bytes que se escriben en el archivo binario.
+//
+// Formato (todos los números enteros en little-endian):
+//
+//   4 bytes   marca "TPPG"
+//   4 bytes   versión del formato (u32, hoy 1)
+//   8 bytes   fecha: segundos desde 1970 (u64)
+//   4 bytes   dificultad de la IA (i32)
+//   4 bytes   largo del nombre en bytes (u32)  -> L
+//   L bytes   nombre del jugador (UTF-8, sin terminador)
+//   --- cartas del jugador ---
+//   4 bytes   cantidad de cartas (u32)         -> N
+//   N veces:  1 byte  tipo (0 fuego, 1 agua, 2 tierra, 3 viento)
+//             4 bytes vida (i32; 0 = carta eliminada)
+//   --- cartas de la IA (igual que las del jugador) ---
+//   4 bytes   cantidad de cartas (u32)
+//   N veces:  1 byte tipo + 4 bytes vida
+std::string serializar_partida(const datos_partida &datos);
+
+// Nombre del archivo donde se guarda la partida de ese jugador, por ejemplo
+// "partida_Ana.bin". Saca los caracteres que no sirven en un nombre de
+// archivo, así que nunca puede apuntar a otra carpeta.
+std::string nombre_de_archivo(const std::string &nombre);
+
+#endif // FORMATO_PARTIDA_H
diff --git a/guardado.cpp b/guardado.cpp
new file mode 100644
index 0000000..35adc3b
--- /dev/null
+++ b/guardado.cpp
@@ -0,0 +1,53 @@
+#include "guardado.h"
+#include <QDir>
+#include <QSaveFile>
+#include <QStandardPaths>
+#include <ctime>
+
+QString guardado::carpeta()
+{
+    // Carpeta de datos de la aplicación (en Windows: %APPDATA%/TrabajoPractico).
+    const QString base = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    if (base.isEmpty())
+        return QString();
+    return base + "/partidas";
+}
+
+bool guardado::guardar(const datos_partida &datos, QString *ruta, QString *error)
+{
+    auto fallo = [error](const QString &motivo) {
+        if (error)
+            *error = motivo;
+        return false;
+    };
+
+    const QString dir = carpeta();
+    if (dir.isEmpty())
+        return fallo("No se encontró una carpeta donde guardar la partida.");
+
+    if (!QDir().mkpath(dir))
+        return fallo("No se pudo crear la carpeta " + dir);
+
+    // Si no se indicó, la fecha es el momento en que se guarda
+    datos_partida copia = datos;
+    if (copia.fecha == 0)
+        copia.fecha = static_cast<std::int64_t>(std::time(nullptr));
+
+    const std::string bytes = serializar_partida(copia);
+    const QString destino = dir + "/" + QString::fromStdString(nombre_de_archivo(copia.nombre));
+
+    // QSaveFile escribe a un archivo temporal y recién al final reemplaza el
+    // original: si algo falla, no queda una partida guardada a medias.
+    // (Se abre sin QIODevice::Text para que los bytes se escriban tal cual.)
+    QSaveFile archivo(destino);
+    if (!archivo.open(QIODevice::WriteOnly))
+        return fallo("No se pudo abrir " + destino + ": " + archivo.errorString());
+
+    const qint64 largo = static_cast<qint64>(bytes.size());
+    if (archivo.write(bytes.data(), largo) != largo || !archivo.commit())
+        return fallo("No se pudo escribir " + destino + ": " + archivo.errorString());
+
+    if (ruta)
+        *ruta = QDir::toNativeSeparators(destino);
+    return true;
+}
diff --git a/guardado.h b/guardado.h
new file mode 100644
index 0000000..6a05835
--- /dev/null
+++ b/guardado.h
@@ -0,0 +1,23 @@
+#ifndef GUARDADO_H
+#define GUARDADO_H
+
+#include <QString>
+#include "formato_partida.h"
+
+// Guarda las partidas en archivos binarios (el formato está explicado en
+// formato_partida.h). Acá solo se decide dónde va el archivo y se escribe.
+class guardado
+{
+public:
+    // Carpeta donde se guardan las partidas.
+    static QString carpeta();
+
+    // Escribe la partida en <carpeta>/partida_<nombre>.bin (si ya existía una
+    // del mismo jugador, la reemplaza). Devuelve true si salió bien; si no,
+    // deja el motivo en *error. En *ruta queda la ruta del archivo escrito.
+    static bool guardar(const datos_partida &datos,
+                        QString *ruta = nullptr,
+                        QString *error = nullptr);
+};
+
+#endif // GUARDADO_H
